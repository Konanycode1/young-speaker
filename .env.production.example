# Copier vers .env.production (jamais commité) puis remplacer chaque CHANGE_ME.
# Lu par push.sh (machine locale) et deploy.sh / docker-compose.prod.yml (serveur).
# Générer un secret : openssl rand -hex 32   (hex uniquement : les valeurs sont insérées dans DATABASE_URL)

# --- Image Docker ---------------------------------------------------------
# Dépôt du registre, ex. ghcr.io/mon-org/young-speaker ou monuser/young-speaker (Docker Hub)
IMAGE_NAME=CHANGE_ME
# Mis à jour automatiquement par ./deploy.sh
IMAGE_TAG=latest

# --- Application ----------------------------------------------------------
# URL publique exacte, avec https:// (cookies « secure », sitemap, métadonnées).
# Intégrée au build : après modification, relancer ./push.sh puis ./deploy.sh.
# 127.0.0.1 = derrière un reverse proxy (recommandé). 0.0.0.0 = exposé directement.
APP_BIND=127.0.0.1
APP_PORT=3901

DATABASE_URL="postgresql://youngspeaker:youngspeaker@localhost:5432/youngspeaker?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3901"

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_USER=youngspeaker
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=youngspeaker

# --- Super administrateur (./deploy.sh seed-admin) ------------------------
SUPER_ADMIN_EMAIL=CHANGE_ME
SUPER_ADMIN_PASSWORD=CHANGE_ME
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_DISPLAY_NAME=Super administration Young Speaker
