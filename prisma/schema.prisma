generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  VISITOR
  YOUNG_SPEAKER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum ArticleStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum ChallengeStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ParticipationStatus {
  JOINED
  COMPLETED
}

enum ExperienceStatus {
  PRIVATE
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ReportReason {
  OFFENSIVE
  HARASSMENT
  MISINFORMATION
  DANGEROUS
  INAPPROPRIATE_SEXUAL
  HATE_SPEECH
  SPAM
  OTHER
}

model User {
  id             String                   @id @default(cuid())
  email          String                   @unique
  passwordHash   String
  role           Role                     @default(YOUNG_SPEAKER)
  profile        Profile?
  articles       Article[]
  votes          Vote[]
  comments       Comment[]
  participations ChallengeParticipation[]
  badges         UserBadge[]
  reports        Report[]
  notifications  Notification[]
  sessions       Session[]
  moodCheckIns   MoodCheckIn[]
  experienceReactions ExperienceReaction[]
  engagementReminders EngagementReminderLog[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  deletedAt      DateTime?
  blockedAt      DateTime?
  blockedReason  String?
  blockedById    String?

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  username    String   @unique
  displayName String
  // Nom complet, facultatif : jamais affiché publiquement, utilisé uniquement
  // pour personnaliser les documents privés (ex. certificat de challenge).
  fullName    String?
  avatarUrl   String?
  ageRange    String?
  city        String?
  country     String?
  bio         String?  @db.VarChar(280)
  interests   String[]
  totalVotes  Int      @default(0)
  totalPoints Int      @default(0)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([totalVotes])
}

model Article {
  id               String        @id @default(cuid())
  authorId         String
  categoryId       String
  weeklyThemeId    String?
  campaignId       String?
  title            String
  slug             String        @unique
  excerpt          String        @db.VarChar(300)
  content          String        @db.Text
  coverImage       String?
  status           ArticleStatus @default(DRAFT)
  sensitiveWarning String?
  rejectionReason  String?
  views            Int           @default(0)
  voteCount        Int           @default(0)
  commentCount     Int           @default(0)
  author           User          @relation(fields: [authorId], references: [id])
  category         Category      @relation(fields: [categoryId], references: [id])
  weeklyTheme      WeeklyTheme?  @relation(fields: [weeklyThemeId], references: [id])
  campaign         AwarenessCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  votes            Vote[]
  comments         Comment[]
  reports          Report[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  publishedAt      DateTime?
  deletedAt        DateTime?

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([weeklyThemeId, voteCount])
  @@index([campaignId])
  @@index([authorId])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  articles    Article[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model WeeklyTheme {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String    @db.Text
  coverImage  String?
  startsAt    DateTime
  endsAt      DateTime
  // Horodatage de l'email annonçant la disponibilité du thème (envoyé une seule fois).
  announcedAt DateTime?
  articles    Article[]
  reminders   EngagementReminderLog[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([startsAt, endsAt])
}

model Vote {
  id          String   @id @default(cuid())
  userId      String?
  articleId   String
  sessionHash String?
  ipHash      String?
  deviceHash  String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([userId, articleId])
  @@unique([sessionHash, articleId])
  @@index([articleId, createdAt])
}

model Comment {
  id          String    @id @default(cuid())
  authorId    String
  articleId   String?
  articleSlug String?
  parentId    String?
  content     String    @db.VarChar(2000)
  isHidden    Boolean   @default(false)
  author      User      @relation(fields: [authorId], references: [id])
  article     Article?  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  parent      Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies     Comment[] @relation("CommentReplies")
  reports     Report[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([articleSlug, createdAt])
  @@index([parentId])
}

model Challenge {
  id             String                   @id @default(cuid())
  title          String
  slug           String                   @unique
  description    String                   @db.Text
  objective      String
  imageUrl       String?
  instructions   String                   @db.Text
  difficulty     String
  reward         String?
  points         Int                      @default(0)
  status         ChallengeStatus          @default(DRAFT)
  // Sujet sensible (bien-être, violences, santé sexuelle...) : exclu des classements
  // publics pour ne pas transformer le sujet en compétition de popularité.
  sensitive      Boolean                  @default(false)
  // Horodatage de l'email annonçant la disponibilité du challenge (envoyé une seule fois).
  announcedAt    DateTime?
  startsAt       DateTime
  endsAt         DateTime
  participations ChallengeParticipation[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([status, startsAt, endsAt])
}

model ChallengeParticipation {
  id          String              @id @default(cuid())
  userId      String
  challengeId String
  status      ParticipationStatus @default(JOINED)
  experience  String?             @db.Text
  experiencePublic Boolean        @default(false)
  experienceStatus ExperienceStatus @default(PRIVATE)
  experienceRejectionReason String?
  joinedAt    DateTime            @default(now())
  completedAt DateTime?
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge   Challenge           @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  reactions   ExperienceReaction[]

  @@unique([userId, challengeId])
  @@index([challengeId, status])
}

// Réaction de soutien sur un témoignage public. Volontairement un seul type
// (pas de mécanique de popularité à plusieurs émojis) et masquée pour les
// challenges sensibles : voir le commentaire sur Challenge.sensitive.
model ExperienceReaction {
  id              String                 @id @default(cuid())
  participationId String
  userId          String
  participation   ChallengeParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime               @default(now())

  @@unique([participationId, userId])
  @@index([participationId])
}

model Badge {
  id             String      @id @default(cuid())
  name           String      @unique
  slug           String      @unique
  description    String
  icon           String
  pointsRequired Int?
  isActive       Boolean     @default(true)
  users          UserBadge[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  articleId  String?
  commentId  String?
  reason     ReportReason
  details    String?
  status     ReportStatus @default(OPEN)
  reporter   User         @relation(fields: [reporterId], references: [id])
  article    Article?     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  comment    Comment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

// Ligne unique (id fixe) portant les réglages globaux de la plateforme.
model SiteSettings {
  id                  String   @id @default("singleton")
  autoPublishArticles Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}

enum Mood {
  VERY_GOOD
  GOOD
  NEUTRAL
  BAD
  VERY_BAD
}

// Auto-évaluation personnelle « Comment vas-tu ? » : strictement liée à son auteur,
// jamais publique. Un modérateur/admin peut la consulter ponctuellement si besoin
// (ex. signalement, inquiétude), jamais via un flux global de tous les utilisateurs.
model MoodCheckIn {
  id         String   @id @default(cuid())
  userId     String
  mood       Mood
  influences String[]
  note       String?  @db.VarChar(500)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

// Empêche de renvoyer deux fois le même rappel (1, 2 ou 3) à la même personne
// pour le même thème, même si la tâche planifiée tourne plusieurs fois le même jour.
model EngagementReminderLog {
  id             String      @id @default(cuid())
  userId         String
  themeId        String
  reminderNumber Int
  sentAt         DateTime    @default(now())
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme          WeeklyTheme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([userId, themeId, reminderNumber])
}

// Campagne de sensibilisation réutilisable (Octobre Rose, puis d'autres mois
// thématiques à venir) : ruban sur les articles + bandeau de message, activable
// et désactivable sans rien supprimer, pour pouvoir la réutiliser plus tard.
model AwarenessCampaign {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  message     String    @db.Text
  color       String
  ctaLabel    String?
  ctaUrl      String?
  // Sujet d'écriture optionnel : affiché comme un « thème spécial » à côté du
  // thème de la semaine habituel, sans le remplacer. Vide = pas de thème spécial.
  themePrompt String?   @db.Text
  isActive    Boolean   @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  articles    Article[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
